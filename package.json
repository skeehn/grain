{
  "name": "grain",
  "version": "0.2.0",
  "description": "Self-improving AI coding agent with persistent memory",
  "keywords": ["ai", "agent", "coding", "llm", "bedrock", "anthropic", "knowledge-graph"],
  "author": "Stephen Keehn <stephen@skeehn.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skeehn/grain.git"
  },
  "bugs": {
    "url": "https://github.com/skeehn/grain/issues"
  },
  "homepage": "https://github.com/skeehn/grain#readme",
  "type": "module",
  "bin": {
    "grain": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node --format esm",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun test && bun run typecheck && bun run build",
    "benchmark:report": "bun scripts/benchmark-report.ts",
    "qualify:local": "bun scripts/qualification.ts",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "0.31.0",
    "@anthropic-ai/sdk": "0.105.0",
    "@aws-sdk/client-bedrock-runtime": "3.1079.0",
    "chalk": "^5.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "bun-types": "1.3.14",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
